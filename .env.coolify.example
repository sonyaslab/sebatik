# Contoh .env untuk varian docker-compose.external-db.yml — SEBATIK memakai
# instance PostgreSQL yang sudah berjalan di server, bukan container sendiri.

SEBATIK_ENVIRONMENT=production

# Host menyesuaikan letak instance PostgreSQL:
#  - PostgreSQL berjalan di host (langsung terpasang di server):
#      postgresql+psycopg://sebatik:SANDI@host.docker.internal:5432/sebatik
#  - PostgreSQL adalah container lain di mesin Docker yang sama: sambungkan
#    container ke jaringan container tersebut lewat UI Coolify, lalu pakai
#    nama container sebagai host (mis. postgres).
#  - PostgreSQL di mesin lain: pakai alamat/hostname biasa.
SEBATIK_DATABASE_URL=postgresql+psycopg://sebatik:GANTI-SANDI@host.docker.internal:5432/sebatik

SEBATIK_ARCHIVE_DIR=/app/data/processed/arsip-unggahan
SEBATIK_EVIDENCE_DIR=/app/data/processed/bukti-dukung
# Wajib acak minimal 32 karakter; aplikasi menolak mulai bila masih bawaan.
SEBATIK_SECRET_KEY=GANTI-DENGAN-STRING-ACAK-MINIMAL-32-KARAKTER
SEBATIK_CORS_ORIGINS=https://sebatik.kaltarastats.id
# Uvicorn memercayai X-Forwarded-For dari alamat ini agar pembatas laju login
# melihat IP pengunjung yang sebenarnya, bukan IP proxy Coolify. Tanda * aman
# sepanjang port aplikasi hanya terikat localhost (lihat compose).
FORWARDED_ALLOW_IPS=*

# Siapkan database dan pengguna di instance yang sudah berjalan (sekali,
# lewat psql sebagai admin):
#   CREATE ROLE sebatik LOGIN PASSWORD 'GANTI-SANDI';
#   CREATE DATABASE sebatik OWNER sebatik;
# Skema dibuat oleh service `migrasi`; pemilik database sudah cukup.
# CI menguji migrasi pada PostgreSQL 16 — untuk versi lain belum teruji.
